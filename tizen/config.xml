<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Samsung TV package's manifest. `tools/build.mjs` copies it beside the page with `version`
  set from this repository's tag (numeric only: a widget version is `x.y.z`).

  `package` and the application id are fixed for the life of the app: a set treats a different
  package id as a different app, and an update must carry the one it already has.

  No `<tizen:allow-navigation>`: adding one switches the runtime to a strict CSP that also blocks
  the inline styles the page writes. `<access origin="*">` is what lets the page reach the host.
  Every privilege here is public level, so no partner certificate is needed to sign it.
  `use.game.mode` puts the set in game mode while the app runs, which drops its picture
  processing: the latency setting a TV owner would otherwise have to find.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/punktfunk/client-tizen"
        version="0.0.1"
        viewmodes="maximized">
  <tizen:application id="punktfunk0.punktfunk" package="punktfunk0" required_version="8.0"/>
  <tizen:profile name="tv-samsung"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>punktfunk</name>
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 hwkey-event="enable"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/use.game.mode" value="true"/>
  <!-- An ultrawide set hands the page more than a 16:9 box: the Odyssey G9 gives 2520×1080
       (21:9; Samsung reserves 32:9 for particular models). `window.innerWidth` follows and the
       page lays itself out to it. Costs about a quarter of the console's frame rate there. -->
  <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
</widget>
