From 372d460ff9da3b23fc902d7f477e5492fb75b4c2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Enrico=20B=C3=BChler?= <enrico.buehler@unom.io>
Date: Fri, 2 Oct 2026 22:19:03 +0000
Subject: [PATCH 1/3] security(host/webtransport): admit a plane session with
 no Origin

A host with Browser origins set refused every WebTransport session that
carried no Origin header, and a packaged Samsung TV page sends none: its
runtime stamps no origin on a dial from file://. So a host whose operator
named the pages that may reach it could not serve a TV at all.

The list exists because WebTransport is not subject to CORS, so any page
open in a browser could dial the plane. A browser always stamps Origin and
a page cannot strip it, so the list still stops every hostile page. What
omits the header is not a page, and a client like that could send any
origin it chose; refusing a missing one kept out nobody. Pairing is what
admits a device.

The docs line on Browser origins says so.
---
 crates/punktfunk-host/src/webtransport.rs     | 21 ++++++++++++++++---
 .../docs/(guide)/(clients)/browser-client.md  |  3 ++-
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/crates/punktfunk-host/src/webtransport.rs b/crates/punktfunk-host/src/webtransport.rs
index eedc1de..7166801 100644
--- a/crates/punktfunk-host/src/webtransport.rs
+++ b/crates/punktfunk-host/src/webtransport.rs
@@ -19,6 +19,7 @@
 //! certificate back to the host fingerprint it pinned.
 
 mod datagrams;
+pub(crate) mod mgmt;
 mod session;
 
 pub(crate) use datagrams::WebTransportPlane;
@@ -290,8 +291,16 @@ async fn accept_loop(
 /// open can reach the plane — the browser will not stop it. An empty allowlist means "anything",
 /// which is what a host with no configured origins has to mean until the console can offer the
 /// choice; the log line below is what tells an operator which value to set.
+///
+/// A session with no `Origin` passes whatever the list says. A browser stamps the header on
+/// every page's dial and no page can strip it, so the list still stops every hostile page; what
+/// omits it is not a page — a packaged TV app, a native tool — and a client like that could
+/// send any origin it chose, so refusing it keeps out nobody. Pairing is what admits a device.
 fn origin_allowed(origin: Option<&str>, allowed: &[String]) -> bool {
-    allowed.is_empty() || origin.is_some_and(|o| allowed.iter().any(|a| a == o))
+    match origin {
+        None => true,
+        Some(o) => allowed.is_empty() || allowed.iter().any(|a| a == o),
+    }
 }
 
 /// May this plane bind at all?
@@ -348,6 +357,11 @@ async fn session(
     if path == "/echo" {
         return echo(connection).await;
     }
+    // The management API for a page that cannot `fetch` the host: no streaming slot, no
+    // handshake clock, its own caps (`mgmt`).
+    if path == "/mgmt" {
+        return mgmt::serve(connection, serving).await;
+    }
 
     let peer = connection.remote_address();
     match session::run(connection.clone(), serving.clone(), sem).await {
@@ -465,8 +479,9 @@ mod tests {
         let allowed = vec!["https://host.local:47990".to_string()];
         assert!(origin_allowed(Some("https://host.local:47990"), &allowed));
         assert!(!origin_allowed(Some("https://evil.example"), &allowed));
-        // A peer that sends no Origin at all must not slip past a configured list.
-        assert!(!origin_allowed(None, &allowed));
+        // No Origin is not a page: a packaged TV app dials without one, and a browser cannot.
+        // The list is a rule for pages, so it does not apply.
+        assert!(origin_allowed(None, &allowed));
         // Exact match only: a prefix or a suffix is a different origin.
         assert!(!origin_allowed(
             Some("https://host.local:47990.evil.example"),
diff --git a/docs-site/content/docs/(guide)/(clients)/browser-client.md b/docs-site/content/docs/(guide)/(clients)/browser-client.md
index 81967c7..7e448e9 100644
--- a/docs-site/content/docs/(guide)/(clients)/browser-client.md
+++ b/docs-site/content/docs/(guide)/(clients)/browser-client.md
@@ -15,7 +15,8 @@ It needs a browser with WebTransport and WebCodecs: current Chrome, Edge, Safari
    streaming**.
 2. Click **Show advanced** and set **Browser origins** to the address you will open the page at,
    for example `https://192.168.1.10:8443`. Left empty, any page open in a browser on your network
-   can reach the host.
+   can reach the host. The list is a rule for browser pages: the Samsung TV app sends no origin
+   and is admitted either way, and pairing is what lets it stream.
 3. Click **Restart Punktfunk**.
 4. Open UDP 9778 on the host: it is in the `punktfunk-native` firewall profile
    ([Ports](/docs/ports)). The video goes from the host to the browser directly.
